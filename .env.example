# ==============================================================================
# Portfolio Environment Variables
# Copy this file to .env.local for local development.
# In production, set these variables in Vercel Project Settings.
# ==============================================================================

# Contact Notification Webhook (Discord, Slack, Zapier, etc.)
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Configuration
# ------------------------------------------------------------------------------
# 1. Create a widget at: https://dash.cloudflare.com -> Turnstile -> Add Site
# 2. Domains: mdshourov.vercel.app, localhost, 127.0.0.1
# 3. Mode: Managed
#
# Client-side Public Site Key (safe to expose to browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Server-side Secret Key (NEVER expose to browser or commit to Git)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# TURNSTILE_SECRET=your_turnstile_secret_key_here  # Alias supported by Turnstile Spin

# Optional: Comma-separated additional allowed hostnames for verification
# TURNSTILE_HOSTNAMES=mdshourov.vercel.app

# ------------------------------------------------------------------------------
# Cloudflare Official Testing Keys (for automated tests or local mock testing)
#
# Always Passes:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Always Fails:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
#   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AB
# ------------------------------------------------------------------------------
